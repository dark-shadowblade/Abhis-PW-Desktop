{
  "name": "abhis-pw-desktop",
  "version": "0.1.0",
  "description": "Abhi's PW desktop study app",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.abhispw.desktop",
    "productName": "Abhi's PW",
    "directories": { "output": "dist" },
    "files": ["desktop/**/*", "server/**/*", "package.json"],
    "win": { "target": ["nsis"], "artifactName": "Abhis-PW-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}